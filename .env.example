# ===== Required =====
# Google AI Studio API key for Nano Banana / Gemini 2.5 Flash Image (aistudio.google.com).
# The code also accepts GOOGLE_AI_API_KEY / GOOGLE_AI_STUDIO_API_KEY / GOOGLE_API_KEY.
GEMINI_API_KEY=

# Webflow Data API token with CMS + Assets read/write
# (Site settings -> Apps & integrations -> API access)
WEBFLOW_API_TOKEN=

# Shared secret guarding the webhook route; append as ?secret=... to the webhook URL
WEBHOOK_SECRET=

# ===== Optional overrides (default to the live Landmark site / Sermons collection) =====
# WEBFLOW_SITE_ID=6966af986dd3f5b0369a84ce
# WEBFLOW_SERMONS_COLLECTION_ID=6975c0cf81c37225e0e2aadd
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ===== Output image optimization (web format + size) =====
# Format for the generated vertical thumbnail: webp (default) | jpeg | avif
# OUTPUT_FORMAT=webp
# Longest-edge width cap in px (2:3 -> ~1.5x tall). Never upscales.
# OUTPUT_MAX_WIDTH=1000
# Target max file size in KB; quality steps down until at/under this.
# OUTPUT_MAX_KB=500

# ===== Asset Manager foldering =====
# Folder that auto-generated verticals are filed into (keeps the panel tidy).
# Set to empty to upload at the top level instead.
# WEBFLOW_ASSET_FOLDER=Sermon Vertical Thumbnails (auto)
